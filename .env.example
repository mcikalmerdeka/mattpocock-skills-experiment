# Doc QA configuration
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# Values in .env take precedence over inherited environment variables.
# Optional defaults below mirror doc_qa/config.py — keep them in sync.

# ── Required ──────────────────────────────────────────────────────────────
# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ── Optional (defaults shown) ─────────────────────────────────────────────
# The chat model that answers your Queries.
DOC_QA_CHAT_MODEL=gpt-5.6-luna
# How much reasoning the chat model does: minimal | low | medium | high
DOC_QA_REASONING_EFFORT=high
# The model that embeds Documents and Queries for Retrieval.
DOC_QA_EMBEDDING_MODEL=text-embedding-3-small
# Where the Vector Store and Conversations are stored on disk.
DOC_QA_DATA_DIR=data
